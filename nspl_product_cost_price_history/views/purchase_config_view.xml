<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_settings_inherit_price_history" model="ir.ui.view">
        <field name="name">purchase.settings.inherit.price.history</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='purchase_setting_container']" position="after">
                <div class="app_settings_block"
                     data-string="Purchase Price History Configuration"
                     string="Purchase Price History Configuration"
                     data-key="purchase_price_history_configuration"
                     groups="purchase.group_purchase_manager">

                    <h2>Purchase Price History</h2>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <field name="item_limit" nolabel="1"/>
                                    </div>
                                </div>
                                <div class="text-muted">
                                    Set item limit for purchase price history.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <field name="price_history_condition" widget="radio" nolabel="1"/>
                                    </div>
                                </div>
                                <div class="text-muted">
                                    Select when the price history should be recorded based on purchase order status.
                                </div>
                            </div>
                        </div>
                    </div>



                </div>
            </xpath>
        </field>
    </record>
</odoo>
