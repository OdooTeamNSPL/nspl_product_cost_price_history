<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_settings_inherit_price_history" model="ir.ui.view">
        <field name="name">purchase.settings.inherit.price.history</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="after">
                <block title="Purchase Price History Configuration" name="purchase_price_history_configuration">
                    <setting id="item_limit_purchase" help="Set item limit for purchase price history.">
                        <field name="item_limit"/>
                    </setting>
                    <setting id="price_history_condition" string="Price History Based On Purchase" help="Select when the price history should be recorded based on purchase order status.">
                        <field name="price_history_condition" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

